// ServiTec marketplace data model.
//
// Monetary values are stored as integer cents in MXN to avoid float drift.
// Stripe receives amounts in the same unit (smallest currency unit).
//
// All Stripe and Facturapi identifiers are stored as strings; we never trust
// the platform-side state and always reconcile through webhooks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth core tables (Prisma adapter contract) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

enum UserRole {
  CLIENT
  TECNICO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String? // E.164 (+52...)
  image         String?
  role          UserRole  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  tecnicoProfile  TecnicoProfile?
  serviceRequests ServiceRequest[] @relation("ClientRequests")
  reviewsWritten  Review[]         @relation("ReviewAuthor")

  @@index([role])
}

enum TecnicoStatus {
  PENDING // signed up, awaiting verification
  APPROVED // can receive requests
  SUSPENDED // temporarily blocked
  REJECTED
}

enum TaxRegime {
  RESICO // Régimen Simplificado de Confianza
  ACTIVIDAD_EMPRESARIAL
  ASIMILADOS
  HONORARIOS
  NONE // tech opted out of CFDI capability
}

model TecnicoProfile {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  displayName              String
  bio                      String?       @db.Text
  yearsExperience          Int?
  // Fiscal data — required to issue CFDI to clients directly.
  // hasCfdiCapability=false means tech is in the temporary grace period.
  hasCfdiCapability        Boolean       @default(false)
  rfc                      String?
  taxRegime                TaxRegime     @default(NONE)
  cfdiPostalCode           String?
  legalName                String? // razón social (may differ from displayName)
  // Stripe Connect (Express account) — required to receive payouts.
  stripeAccountId          String?       @unique
  stripeOnboardingComplete Boolean       @default(false)
  stripeChargesEnabled     Boolean       @default(false)
  stripePayoutsEnabled     Boolean       @default(false)
  // Service area
  baseLat                  Float?
  baseLng                  Float?
  coverageRadiusKm         Int           @default(15)
  // KYC
  idDocumentUrl            String?
  status                   TecnicoStatus @default(PENDING)
  approvedAt               DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories TecnicoCategory[]
  quotes     Quote[]
  bookings   Booking[]         @relation("TecnicoBookings")

  @@index([status])
  @@index([stripeAccountId])
}

model ServiceCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  tecnicos        TecnicoCategory[]
  serviceRequests ServiceRequest[]
}

model TecnicoCategory {
  tecnicoId  String
  categoryId String

  tecnico  TecnicoProfile  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tecnicoId, categoryId])
  @@index([categoryId])
}

enum ServiceRequestStatus {
  OPEN // accepting quotes
  QUOTED // at least one quote received
  ACCEPTED // client picked a quote -> booking created
  CANCELLED
  EXPIRED
}

model ServiceRequest {
  id            String               @id @default(cuid())
  clientId      String
  categoryId    String
  title         String
  description   String               @db.Text
  addressLine   String
  postalCode    String
  city          String
  state         String
  locationLat   Float?
  locationLng   Float?
  photos        Json? // string[] of R2/S3 URLs
  preferredDate DateTime?
  status        ServiceRequestStatus @default(OPEN)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  client   User            @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  quotes   Quote[]
  booking  Booking?

  @@index([clientId])
  @@index([categoryId, status])
  @@index([status, createdAt])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model Quote {
  id                   String      @id @default(cuid())
  requestId            String
  tecnicoId            String
  laborAmountCents     Int
  materialsAmountCents Int         @default(0)
  totalAmountCents     Int // = labor + materials, snapshotted at acceptance
  notes                String?     @db.Text
  validUntil           DateTime
  status               QuoteStatus @default(PENDING)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tecnico TecnicoProfile @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  booking Booking?

  @@unique([requestId, tecnicoId])
  @@index([tecnicoId, status])
  @@index([requestId, status])
}

enum BookingStatus {
  PENDING_PAYMENT // checkout session created, awaiting payment
  PAID // payment captured
  IN_PROGRESS // tech started the service
  COMPLETED // tech marked complete, funds release pending
  DISPUTED
  CANCELLED
  REFUNDED
}

model Booking {
  id                    String        @id @default(cuid())
  quoteId               String        @unique
  requestId             String        @unique
  clientId              String
  tecnicoId             String
  totalAmountCents      Int // snapshot from accepted quote
  commissionAmountCents Int // 12% of total, rounded
  tecnicoNetCents       Int // total - commission
  scheduledFor          DateTime?
  status                BookingStatus @default(PENDING_PAYMENT)
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  quote          Quote           @relation(fields: [quoteId], references: [id])
  request        ServiceRequest  @relation(fields: [requestId], references: [id])
  tecnico        TecnicoProfile  @relation("TecnicoBookings", fields: [tecnicoId], references: [id])
  payment        Payment?
  commissionCfdi CommissionCfdi?
  review         Review?

  @@index([clientId])
  @@index([tecnicoId, status])
  @@index([status, createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  stripeChargeId          String?       @unique
  stripeTransferId        String? // transfer to tecnico's connected account
  stripeApplicationFeeId  String? // the 12% commission fee
  amountCents             Int
  currency                String        @default("mxn")
  status                  PaymentStatus @default(PENDING)
  refundedAmountCents     Int           @default(0)
  failureCode             String?
  failureMessage          String?
  createdAt               DateTime      @default(now())
  paidAt                  DateTime?
  refundedAt              DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum CommissionCfdiStatus {
  PENDING // payment captured, CFDI not yet issued
  ISSUED
  FAILED // Facturapi error; retry queue
  CANCELLED
}

// CFDI issued by Edgar (platform) to técnico for the 12% commission.
// Single-source-of-truth links: bookingId 1:1, facturapiInvoiceId unique.
model CommissionCfdi {
  id                     String               @id @default(cuid())
  bookingId              String               @unique
  facturapiInvoiceId     String?              @unique
  facturapiInvoiceNumber String?
  pdfUrl                 String?
  xmlUrl                 String?
  uuid                   String? // SAT fiscal folio (UUID)
  totalCents             Int
  status                 CommissionCfdiStatus @default(PENDING)
  errorMessage           String?
  retryCount             Int                  @default(0)
  issuedAt               DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  authorId  String // typically clientId
  rating    Int // 1..5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@index([authorId])
}

enum ContactAudience {
  CLIENT
  TECNICO
  PRESS
  OTHER
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
  SPAM
}

model ContactMessage {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String?
  audience        ContactAudience @default(OTHER)
  city            String?
  serviceCategory String?
  message         String          @db.Text
  status          ContactStatus   @default(NEW)
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime        @default(now())

  @@index([status, createdAt])
  @@index([audience, createdAt])
}

// Idempotency log for Stripe webhooks. The primary key is the Stripe event id,
// so a unique constraint violation on insert means "already processed".
model WebhookEvent {
  id          String   @id // Stripe event.id
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@index([type, processedAt])
}

// ---------- Phone OTP ----------

enum PhoneVerificationPurpose {
  SIGNUP
  PROFILE_UPDATE
  LOGIN
}

model PhoneVerification {
  id         String                   @id @default(cuid())
  phone      String // E.164
  codeHash   String // SHA-256 of the OTP
  purpose    PhoneVerificationPurpose @default(LOGIN)
  attempts   Int                      @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  userId     String? // bound to a session if known
  ipAddress  String?
  createdAt  DateTime                 @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// ---------- Notifications ----------

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  subject   String
  body      String              @db.Text
  status    NotificationStatus  @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ---------- Audit log ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // null for system events
  action    String // e.g. "tecnico.approve", "booking.refund"
  entity    String // e.g. "TecnicoProfile", "Booking"
  entityId  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
