# ============================================================================
# ServiTec — environment variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — only this template is tracked.
# All variables are required in production unless marked OPTIONAL.

# ---------- App ----------
# Public site URL. Used for absolute links in emails, OG images, and Stripe
# redirect URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://serviciosintegralesapp.com"

# Node environment is set by Next; do not override here.

# ---------- Database ----------
# Postgres connection string. Works with Neon, Supabase, Railway, or any
# Postgres ≥ 14. Use the *pooled* URL for the app and the *direct* URL for
# migrations if your provider distinguishes them.
DATABASE_URL="postgresql://user:password@host:5432/servitec?schema=public"

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-byte-random-string"
NEXTAUTH_URL="https://serviciosintegralesapp.com"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Resend (transactional email) ----------
# Create at https://resend.com — verify the sending domain.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="ServiTec <noreply@serviciosintegralesapp.com>"
# Inbox that receives contact-form submissions.
CONTACT_INBOX_EMAIL="servitec@serviciosintegralesapp.com"

# ---------- Stripe ----------
# Test keys for development, live keys for production. Never commit live keys.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public key is exposed to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Commission percent (whole number). 12 → 12%. Mirrors site.commission.rate.
STRIPE_COMMISSION_PERCENT="12"

# ---------- Facturapi (CFDI 4.0) ----------
# Create at https://facturapi.io — separate sandbox and live keys.
FACTURAPI_API_KEY="sk_test_..."
# Platform fiscal identity used as CFDI emitter for commission invoices.
# This is Edgar's RFC. Update if/when migrating to S.A. de C.V.
PLATFORM_RFC="GOME900115AA4"
PLATFORM_LEGAL_NAME="EDGAR DANIEL GODOY MONTALVO"
PLATFORM_TAX_REGIME="626"          # 626 = RESICO Persona Física (SAT catalog)
PLATFORM_POSTAL_CODE="89180"

# ---------- Object Storage (S3-compatible: AWS S3, Cloudflare R2, etc.) ----------
# Used for service request photos and técnico KYC documents. Any S3-API
# compatible provider works — set the endpoint accordingly.
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="servitec-uploads"
# Public base URL where objects are served (CDN/origin). No trailing slash.
S3_PUBLIC_URL="https://uploads.serviciosintegralesapp.com"

# ---------- SMS (phone OTP) — OPTIONAL ----------
# When unset, OTP codes are logged to the server console instead of sent.
# Useful for development; required for production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1234567890"

# ---------- Cron / internal jobs ----------
# Shared secret required to invoke /api/cron/*. Vercel Cron passes this as
# `Authorization: Bearer <CRON_SECRET>`. Generate with openssl rand -hex 32.
CRON_SECRET="replace-with-32-byte-random-string"

# ---------- Logging / Observability (OPTIONAL) ----------
# Sentry DSN — leave blank to disable.
SENTRY_DSN=""
